{
  "name": "ctc-call-tracking",
  "version": "1.0.0",
  "description": "Multi-client call tracking (CallRail alternative) — Twilio DNI, recording, attribution, conversion push. Ruler Agency.",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node tools/migrate.js",
    "seed": "node tools/seed.js",
    "simulate": "node test/simulate.js",
    "test": "node --test --require ./test/setup.js \"test/*.test.js\"",
    "build": "vite build --config web/vite.config.mts",
    "dev:web": "vite --config web/vite.config.mts",
    "typecheck": "tsc -p web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-ads-api": "^17.1.0",
    "twilio": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "lucide-react": "^1.68.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
