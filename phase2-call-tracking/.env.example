# ── Server ─────────────────────────────────────────────
PORT=8080
# Public HTTPS base URL of THIS server (Twilio must reach it). e.g. https://calls.ruler.agency
PUBLIC_BASE_URL=https://calls.example.com
DB_PATH=./data/calls.db
# On Vercel: a Turso database instead of the file (VERCEL.md)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Protects /api/cron/reports (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# ── Branding (the self-hosted UI) ──────────────────────
BRAND_NAME=Ruler CallTrack
BRAND_COMPANY=Ruler Agency

# ── Web app sign-in ────────────────────────────────────
# On first boot, when there are no users yet, these become the first OWNER account. After that, people
# (team members and client logins) are managed in Settings › Team; changing these values does nothing.
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_something_strong
# Long random string — sign session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=12

# ── Twilio (ACCOUNT-LEVEL FALLBACK ONLY) ───────────────
# Each client carries its OWN Twilio creds in the admin UI. These are only used
# as a fallback if a client has none set. Safe to leave blank in multi-client setups.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Reject webhooks whose X-Twilio-Signature doesn't validate (keep true in production)
VALIDATE_TWILIO_SIGNATURE=true

# ── Defaults applied to clients unless overridden in DB ─
DEFAULT_QUALIFIED_DURATION_SEC=30
# Session number reservation window (how long an assigned DNI number maps to a visitor)
SESSION_TTL_MINUTES=60
# Repeat-caller window (a caller seen within N days counts as "repeat")
REPEAT_CALLER_WINDOW_DAYS=90

# ── Google Ads (offline click conversions) ─────────────
# One developer token for the agency MCC; per-client customer_id lives in the clients table.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Transcription ──────────────────────────────────────
# 'twilio' = use Twilio async transcription; 'none' = store recording only; 'openai' = Whisper
TRANSCRIPTION_PROVIDER=twilio
OPENAI_API_KEY=

# ── Report API (/api/report/*) ─────────────────────────
# Never open: callers send this as X-Api-Key (sees every client), or a personal ct_ token as
# Authorization: Bearer (sees that user's clients). Tokens are made in Settings › API and MCP.
REPORT_API_KEY=

# ── Email (missed-call alerts, scheduled reports) ──────
# Without SMTP_HOST email is off; Slack alerts and webhooks still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ruler Calls <calls@example.com>

# ── AI call summaries (Claude) ─────────────────────────
# Summaries run when a transcript arrives, and transcripts come from Whisper: set TRANSCRIPTION_PROVIDER=openai and
# OPENAI_API_KEY too. With the default provider (twilio) no transcript is made and no summary runs.
# Data: the call audio goes to OpenAI, the transcript to Anthropic. Both must be in the clients' privacy notices.
# AI_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
AI_MODEL=

# ── Behind a proxy ─────────────────────────────────────
# Which hops to trust for the visitor's address (the sign-in brake). Default: loopback, uniquelocal (Caddy in compose).
TRUST_PROXY=

# ── Viber alerts (one agency bot) ──────────────────────
# Viber bots are commercial since 5 Feb 2024 (apply with Rakuten Viber or a partner; third parties quote ~EUR 100/month
# per bot, and messages outside a 24-hour conversation are billed by country). Token: Viber › Settings › Bots › Edit info.
# After deploying (https PUBLIC_BASE_URL), run once: node tools/viber-set-webhook.js
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=Ruler Calls
# The bot's URI, for an "Open the bot" link in the app (optional)
VIBER_BOT_URI=
